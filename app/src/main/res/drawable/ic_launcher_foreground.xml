<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Top stopwatch pusher / timer button -->
    <path
        android:pathData="M48,22h12v4h-12z"
        android:fillColor="#E2E8F0" />
    <path
        android:pathData="M51,26h6v3h-6z"
        android:fillColor="#94A3B8" />

    <!-- Top-right stopwatch accent pusher -->
    <path
        android:pathData="M73.5,29.5l3.5,-3.5l3,3l-3.5,3.5z"
        android:fillColor="#F59E0B" />

    <!-- Outer Stopwatch/Clock Dial Base (Circular with stylized Chomp bite on upper right) -->
    <path
        android:pathData="M54,28 C68.36,28 80,39.64 80,54 C80,68.36 68.36,80 54,80 C39.64,80 28,68.36 28,54 C28,39.64 39.64,28 54,28 Z"
        android:strokeWidth="3.5"
        android:strokeColor="#334155">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="28"
                android:startY="28"
                android:endX="80"
                android:endY="80"
                android:type="linear">
                <item android:color="#1E293B" android:offset="0.0" />
                <item android:color="#0F172A" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Fasting Active Progress Arc (Vibrant emerald glow) -->
    <path
        android:pathData="M54,33 A21,21 0 1,1 33,54"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="33"
                android:startY="33"
                android:endX="75"
                android:endY="75"
                android:type="linear">
                <item android:color="#F59E0B" android:offset="0.0" />
                <item android:color="#10B981" android:offset="0.6" />
                <item android:color="#22C55E" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Tick marks -->
    <path
        android:pathData="M54,36v3 M72,54h-3 M54,72v-3 M36,54h3"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeColor="#64748B"
        android:fillColor="#00000000" />

    <!-- Playful Chomp Bite Marks on Right Dial -->
    <path
        android:pathData="M78,44 A4.5,4.5 0 0,1 78,53 A4.5,4.5 0 0,1 78,62"
        android:strokeWidth="2.8"
        android:strokeLineCap="round"
        android:strokeColor="#F59E0B"
        android:fillColor="#00000000" />

    <!-- Clock Hour Hand (Emerald) -->
    <path
        android:pathData="M54,54 L44,44"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:strokeColor="#22C55E"
        android:fillColor="#00000000" />

    <!-- Clock Minute Hand (White/Bright) -->
    <path
        android:pathData="M54,54 L62,38"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:strokeColor="#FFFFFF"
        android:fillColor="#00000000" />

    <!-- Glowing Center Dial Pivot Pin -->
    <path
        android:pathData="M54,54m-4.5,0a4.5,4.5 0 1,1 9,0a4.5,4.5 0 1,1 -9,0"
        android:fillColor="#F59E0B" />
    <path
        android:pathData="M54,54m-2,0a2,2,0 1,1 4,0a2,2,0 1,1 -4,0"
        android:fillColor="#FFFFFF" />
</vector>
